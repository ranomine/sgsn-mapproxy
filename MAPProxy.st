: 'HolgerHansPeterFreyther 12/14/2014 19:10' prior: 0!I convert between GSUP and MAP.!!MAPProxy methodsFor: 'logging' stamp: ' 12/6/2023 14:52:25'!formatForLogging	^ String streamContents: [ :stream | 		  stream			  nextPutAll: self class printString;			  nextPut: $(;			  nextPutAll: self class NodeName , ' Number=';			  nextPutAll: (self localSCCPAddress ifNil: [ 'nil' ]);			  nextPut: $) ]! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!initialize	gts := OrderedCollection new.	logger := LogStructuredLogger for: self area: #mapProxy! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!gsupServer: aServer	gsupServer := aServer! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!purgeMS: aRequest for: aDelegate	self subclassResponsibility! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!newDialogue	| diag |	diag := endPoint newDialogue.	(diag respondsTo: #removeDefaultSubscription) ifTrue: [		diag removeDefaultSubscription].	^diag! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!returnUpdateGprsLocationFailureFor: aRequest on: aDelegate	| error |	logger logError: 'updateGprsLocation failed' with: { 'imsi' ->  aRequest mobileIdentity fromTBCD}.	"TODO: handle the cause better"	error := MAPProxyUpdateGprsLocationError new.	error mobileIdentity: aRequest mobileIdentity.	aDelegate sendGSUP: error toMessage asByteArray.! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!localSCCPAddress	self subclassResponsibility! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!endPoint: anEndpoint	endPoint := anEndpoint.	endPoint onDialogue: [:diag |		"In case we run on the HLR code or such"		(diag dialogue respondsTo: #removeDefaultSubscription) ifTrue: [			diag removeDefaultSubscription].		diag onInvoke: [:inv |			self handleInvocation: inv]]! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!calledHLRAddress: aGT 	logger logDebug: 'Creating called SCCPAddress for hlr-Number' with: { 'gt' -> aGT }.	^ (SCCPAddress createForSSN: #hlr)		routedOnSSN: false;		gtiFromAddr:  (SCCPGlobalTitleTranslation new							nature: SCCPGlobalTitle naiInternationalNumber;							plan: SCCPGlobalTitle npISDN;							addr: aGT;							translation: 0;							yourself);		yourself! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!sendAuthenticationInfo: aRequest for: aDelegate	| imsi gt |	imsi := 	aRequest mobileIdentity fromTBCD.	logger logDebug: 'GSUP request for sendAuthentication' with: { 'imsi' ->  imsi}.	gt := self gtForIMSI: imsi.	gt operationForAuthentication new		dialogue: self newDialogue;		callingSCCPAddress: (self callingSCCPAddress: gt callingSSN);		calledSCCPAddress: (self calledSCCPAddress: (gt prepare: imsi));		imsi: imsi;		onFailure: [self returnSendAuthenticationFailureFor: aRequest on: aDelegate];		onSuccess: [:result | self returnSendAuthenticationResultFor: aRequest with: result on: aDelegate];		start.! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!returnSendAuthenticationFailureFor: aRequest on: aDelegate	| error |	logger logError: 'sendAuthentication failed' with: { 'imsi' ->  aRequest mobileIdentity fromTBCD}.	"TODO: handle the cause better"	error := MAPProxySendAuthenticationInfoError new.	error mobileIdentity: aRequest mobileIdentity.	error cause: #[2r10000].	aDelegate sendGSUP: error toMessage asByteArray.! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!returnPurgeMSFailureFor: aRequest on: aDelegate	| error |	logger logError: 'purgeMS failed' with: { 'imsi' ->  aRequest mobileIdentity fromTBCD}.	"TODO: handle the cause better"	error := MAPProxyPurgeMSError new.	error mobileIdentity: aRequest mobileIdentity.	aDelegate sendGSUP: error toMessage asByteArray.! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!handleInvocation: invocationReceived	| conns |	logger logDebug: 'Received invocation' with: { 'operationName' -> invocationReceived operationName }.	invocationReceived invocation returnResultLast: nil.	invocationReceived dialogue requestTcEnd: false.	self flag: #todo. "Spawn a real transaction on our own.."	conns := gsupServer allConnections.	conns isEmpty ifTrue: [^self].		(invocationReceived operationName = 'cancelLocationV2') ifTrue: [		| cancel |		cancel := MAPProxyCancellationRequest new.		cancel mobileIdentity: invocationReceived  argument imsi.		cancel cause: #[0].		conns first readDelegate sendGSUP: cancel toMessage asByteArray	].	(invocationReceived operationName = 'cancelLocationV3') ifTrue: [		| cancel type argument |		argument := invocationReceived argument.		argument cancellationType isNil			ifFalse: [				type := {((argument value type elementAt: 'cancellationType') atName: argument cancellationType) number}]			ifTrue: [				type := #[0]].		cancel := MAPProxyCancellationRequest new.		cancel mobileIdentity: invocationReceived  argument identity imsi.		cancel cause: type.		conns first readDelegate sendGSUP: cancel toMessage asByteArray	].! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!returnUpdateGprsLocationResultFor: aRequest with: anOperation on: aDelegate result: aResult	| result hlrNumber |	(aResult find: 'hlr-Number') ifNotNil: [:number |		hlrNumber := number contents fromE164].	logger logNotice: 'updateGprs result' with: { 'imsi' ->  aRequest mobileIdentity fromTBCD. 'hlrNumber' -> hlrNumber}.	"TODO.. aResult should collect all ISD invocations..."	result := MAPProxyUpdateGprsLocationResult new.	result mobileIdentity: aRequest mobileIdentity.	result hlrNumber: ((aResult find: 'hlr-Number') ifNotNil: [ :number | number contents ]).	anOperation pdpInfoComplete ifTrue: [		result pdpInfoComplete: true].	result pdpInfos: anOperation pdpInfos.	result msisdn: anOperation msisdn.	result chargingCharacteristics: anOperation chargingCharacteristics.	aDelegate sendGSUP: result toMessage asByteArray.! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!returnPurgeMSResultFor: aRequest with: aResult on: aDelegate	| result |	logger logError: 'purgeMS result' with: { 'imsi' ->  aRequest mobileIdentity fromTBCD}.	result := MAPProxyPurgeMSResult  new.	result mobileIdentity: aRequest mobileIdentity.	aDelegate sendGSUP: result toMessage asByteArray.! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!calledSCCPAddress: aGT	logger logDebug: 'Creating called SCCPAddress' with: { 'gt' -> aGT }.	^ (SCCPAddress createForSSN: #hlr)		routedOnSSN: false;		gtiFromAddr:  (SCCPGlobalTitleTranslation new							nature: SCCPGlobalTitle naiInternationalNumber;							plan: SCCPGlobalTitle npMobile;							addr: aGT;							translation: 0;							yourself);		yourself! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!addGT: aGT	logger logDebug: 'Adding GT' with: {aGT}.	gts add: aGT! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!returnUpdateLocationResultFor: aRequest with: anOperation on: aDelegate result: aResult	| result hlrNumber |	(aResult find: 'hlr-Number') ifNotNil: [:number |		hlrNumber := number contents fromE164].	logger logNotice: 'updateGprs result' with: { 'imsi' ->  aRequest mobileIdentity fromTBCD. 'hlrNumber' -> hlrNumber}.	"TODO.. aResult should collect all ISD invocations..."	result := MAPProxyUpdateGprsLocationResult new.	result mobileIdentity: aRequest mobileIdentity.	result hlrNumber: ((aResult find: 'hlr-Number') ifNotNil: [ :number | number contents ]).	anOperation pdpInfoComplete ifTrue: [		result pdpInfoComplete: true].	result pdpInfos: anOperation pdpInfos.	result msisdn: anOperation msisdn.	result chargingCharacteristics: anOperation chargingCharacteristics.	aDelegate sendGSUP: result toMessage asByteArray.! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!gtForIMSI: anIMSI	logger logDebug: 'Searching GTfor IMSI' with: { 'imsi' -> anIMSI }.	gts do: [:each |		(each matches: anIMSI)			ifTrue: [^each]].	^self error: 'No known GT remapping'! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!returnSendAuthenticationResultFor: aRequest with: aList on: aDelegate	| result |	logger logError: 'sendAuthentication result' with: { 'imsi' ->  aRequest mobileIdentity fromTBCD}.	result := MAPProxySendAuthenticationInfoResult new.	result mobileIdentity: aRequest mobileIdentity.	aList do: [:each |		result addAuthTuple: (MAPProxyAuthTuple new								rand: each rand; sres: each sres; kc: each kc;								yourself)].	aDelegate sendGSUP: result toMessage asByteArray.! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!returnUpdateLocationFailureFor: aRequest on: aDelegate	| error |	logger logError: 'updateLocation failed' with: { 'imsi' ->  aRequest mobileIdentity fromTBCD}.	"TODO: handle the cause better"	error := MAPProxyUpdateLocationError new.	error mobileIdentity: aRequest mobileIdentity.	aDelegate sendGSUP: error toMessage asByteArray.! !!MAPProxy methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!callingSCCPAddress: aSSN	logger		logDebug: 'Creating calling SCCP Address'		with: { ('ssn' -> aSSN) }.	^ (SCCPAddress createWith: aSSN)		  routedOnSSN: false;		  gtiFromAddr: (SCCPGlobalTitleTranslation new				   nature: SCCPGlobalTitle naiInternationalNumber;				   plan: SCCPGlobalTitle npISDN;				   addr: self localSCCPAddress;				   translation: 0;				   yourself);		  yourself! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!MAPProxy class	instanceVariableNames: 'asn1Model'!!MAPProxy class methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!defaultAsn1Model	^ (ASN1 new 		addLibrary: ROSModuleLibrary new;		addLibrary: MAPModuleLibrary new;		addLibrary: TCAPModuleLibrary new;		model)  asTcapModelRoot! !!MAPProxy class methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!asn1Model	^ asn1Model ifNil: [ 		asn1Model := self defaultAsn1Model ] ! !!MAPProxy class methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!asn1Model: anObject	asn1Model := anObject! !!MAPProxy class methodsFor: 'resetting' stamp: ' 12/6/2023 14:52:25'!reset	asn1Model := nil! !Object subclass: #MAPProxyGT	instanceVariableNames: 'imsiRangeMatch prefix operationForAuthentication operationForPurgeMS callingSSN'	classVariableNames: ''	package: 'MAPProxy-Core'!!MAPProxyGT methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!operationForPurgeMS: aClass 	operationForPurgeMS := aClass! !!MAPProxyGT methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!operationForPurgeMS	^ operationForPurgeMS! !!MAPProxyGT methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!replaceStart: aPrefix	prefix := aPrefix! !!MAPProxyGT methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!operationForAuthentication: aClass 	operationForAuthentication := aClass! !!MAPProxyGT methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!operationForAuthentication	^ operationForAuthentication! !!MAPProxyGT methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!callingSSN	^ callingSSN! !!MAPProxyGT methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!initialize	super initialize.	operationForPurgeMS := MAPProxyPurgeMSV3Operation.	callingSSN := SCCPAddress ssnHLR.! !!MAPProxyGT methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!callingSSN: aSSN	callingSSN := aSSN! !!MAPProxyGT methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!imsiRange: aMatcher	imsiRangeMatch := aMatcher! !!MAPProxyGT methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!matches: aString 	^imsiRangeMatch matches: aString! !!MAPProxyGT methodsFor: 'bytecode decoding' stamp: ' 12/6/2023 14:52:25'!prepare: aString	"If () is used in the expression let's replace the match with	the prefix"	imsiRangeMatch matches: aString.	^((imsiRangeMatch matches: aString) and: [imsiRangeMatch subexpressionCount > 1])		ifTrue: [			| start end |			start := (imsiRangeMatch subBeginning: 2) first.			end := (imsiRangeMatch subEnd: 2) first.			aString copyReplaceFrom: start + 1 to: end with: prefix]		ifFalse: [			aString copyReplaceFrom: 1 to: prefix size  with: prefix].! !OsmoMessageIPAReadDelegate subclass: #MAPProxyReadDelegate	instanceVariableNames: 'mapProxy'	classVariableNames: ''	package: 'MAPProxy-Core'!!MAPProxyReadDelegate methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!handleGSUP: aCollection 	| msg |	msg := MAPProxyMessageBase readFrom: aCollection readStream.	msg dispatchMAPProxyOn: self.! !!MAPProxyReadDelegate methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!mapProxy	^ mapProxy! !!MAPProxyReadDelegate methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!inject: aByteArray with: protocol	dispatcher dispatch: protocol with: aByteArray! !!MAPProxyReadDelegate methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!mapProxy: aProxy 	mapProxy := aProxy! !!MAPProxyReadDelegate methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!sendGSUP: aMessage	self nextPut: aMessage with: IPAConstants protocolOsmoGSUP! !!MAPProxyReadDelegate methodsFor: 'as yet unclassified' stamp: ' 12/6/2023 14:52:25'!onNewConnection: aSocket	super onNewConnection: aSocket.	dispatcher 	    addHandler: IPAConstants protocolOsmoGSUP on: [:msg | self handleGSUP: msg].! !Object subclass: #MAPProxyRuleParser	instanceVariableNames: 'mapProxy logger'	classVariableNames: ''	package: 'MAPProxy-Core'!!MAPProxyRuleParser commentStamp: 'HolgerHansPet